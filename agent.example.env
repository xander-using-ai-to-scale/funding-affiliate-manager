# Funding Affiliate Manager — copy to ~/.fam/agent.env on the droplet (chmod 600). NEVER commit real values.

# ── Model (OpenRouter) ──────────────────────────────────────────────
OPENROUTER_API_KEY=
PRIMARY_MODEL=anthropic/claude-sonnet-5
FALLBACK_MODEL=anthropic/claude-haiku-4.5

# ── GoHighLevel: the DEMO location only (Private Integration Token, pit-...) ──
# Keep FAM_GHL_MODE=mock until the demo sub-account + PIT exist, then switch to live and run `fam ghl bootstrap --apply`.
FAM_GHL_MODE=mock
FAM_DEMO_MODE=1            # 1 = only contacts tagged fam:test-contact receive real messages
GHL_API_KEY=
GHL_LOCATION_ID=
FAM_MANAGER_USER_NAME=     # GHL user who gets follow-up tasks (partial name match)

# ── The agent's own Orgo computer (workspace-scoped key) ────────────
ORGO_API_KEY=
ORGO_COMPUTER_ID=
ORGO_MCP_VERSION=1.1.1

# ── Browsers (skills, not the focus) ────────────────────────────────
SUPER_BROWSER_TOKEN=
BROWSER_BOX_URL=
BROWSER_BOX_TOKEN=

# ── Manager channel: Slack app (socket mode) ────────────────────────
SLACK_BOT_TOKEN=           # xoxb-...
SLACK_APP_TOKEN=           # xapp-... (connections:write)
SLACK_HOME_CHANNEL=        # channel ID of #funding-affiliates
SLACK_ALLOWED_USERS=       # comma-separated Slack member IDs allowed to talk to / approve for the agent

# ── Obsidian vault sync (private repo) ──────────────────────────────
VAULT_GIT_REMOTE=          # e.g. git@github.com:jbellsolutions/fam-vault.git

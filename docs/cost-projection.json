  "wave_gates": [
    "Opt-outs stay under a ceiling agreed before the pilot (we suggest 3% of texts sent)",
    "No carrier filtering or spam flags on the number",
    "7FF has read a sample of the conversations and is happy with the tone",
    "Deals from replies are reaching the funding team and being counted by tier",
    "AI spend is tracking the projection, inside the starting budget"
  ],
  "wave_notes": [
    "Jev reads all 13,000 records once at import (about $0.49).",
    "The texting number is registered for A2P 10DLC ($71.91 one time).",
    "How many texts a day the carriers allow depends on the trust score they give 7FF's registration. A low score caps daily volume and makes each wave take longer; it doesn't change the cost."
  ],
  "spec": [
    {
      "part": "Hermes agent (the affiliate manager)",
      "status": "Built",
      "does": "Runs the daily loop, triages replies, talks with the manager in Slack, and puts every send on an approval card."
    },
    {
      "part": "Affiliate engine and GoHighLevel connector",
      "status": "Built",
      "does": "Cadence rules, lifecycle tags, notes, tasks, approvals, opt-out handling, and a guard that keeps every text to one segment."
    },
    {
      "part": "Simulation and reporting",
      "status": "Built",
      "does": "Runs the same code against a synthetic CRM, as in this pack's simulation tab."
    },
    {
      "part": "GoHighLevel sub-account and texting number",
      "status": "Set up",
      "does": "Holds the reactivation contacts, tags and conversations. The number is registered for A2P 10DLC before any text goes out."
    },
    {
      "part": "Models through OpenRouter",
      "status": "Set up",
      "does": "The agent and the message worker run on GPT-6 Luna Pro, with GLM 5.3 Flash as the fallback. Luna Pro was tested driving the agent's own tools on September 23, 2026. Usage is reported to 7FF every month."
    },
    {
      "part": "Zoho to GoHighLevel partner import (read-only)",
      "status": "To build",
      "does": "Copies partner name, tier, contact details and deal history into GoHighLevel. Nothing is written back to Zoho, and partners with payroll integrations stay where they are."
    },
    {
      "part": "Jev ingestion, checking and classifying",
      "status": "To build",
      "does": "Cleans each partner record on the way in, checks every draft against the compliance rules, and labels every reply."
    },
    {
      "part": "Message worker",
      "status": "To build",
      "does": "Drafts each kickoff and reply on GPT-6 Luna Pro, falling back to GLM 5.3 Flash. Runs outside the agent so each text pays only for its own short prompt; the kickoff runs in batch mode."
    },
    {
      "part": "Consent gate",
      "status": "To build",
      "does": "Texts only partners with a mobile number and SMS consent on file. Everyone else gets email and the newsletter."
    },
    {
      "part": "Deal attribution by tier",
      "status": "To build",
      "does": "Tags each re-engaged partner with their tier so every deal from the reactivation is counted against the right share. Needs 7FF's deal data."
    }
  ],
  "flow": [
    {
      "step": "Import",
      "what": "Partner records come over from Zoho, Jev cleans them, and each lands in GoHighLevel tagged with tier and status."
    },
    {
      "step": "Gate",
      "what": "Only partners with a mobile number and SMS consent get a text. STOP is final."
    },
    {
      "step": "Draft",
      "what": "The message worker writes one kickoff per partner from their record: name, tier, last deal, niche. Jev checks each draft."
    },
    {
      "step": "Approve",
      "what": "In the pilot a person approves each text in Slack. Later waves go out as sampled batches under a standing approval with a daily send limit."
    },
    {
      "step": "Send",
      "what": "GoHighLevel sends from the registered number, in daytime hours, within the daily send limit."
    },
    {
      "step": "Converse",
      "what": "Jev labels each reply and the worker drafts the answer under the same approval rules. Deals, commission questions and anything sensitive go to a person as a task."
    },
    {
      "step": "Report",
      "what": "A daily summary in Slack and a weekly scorecard: replies, opt-outs, deals by tier, and AI spend against the budget."
    }
  ],
